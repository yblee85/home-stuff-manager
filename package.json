{
  "name": "home-stuff-manager",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "test": "pnpm --filter api test && pnpm --filter web test",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "lint": "pnpm lint:api && pnpm lint:web",
    "lint:api": "eslint -c apps/api/eslint.config.mjs \"apps/api/src/**/*.ts\"",
    "lint:web": "pnpm --filter web lint"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.10",
    "typescript-eslint": "^8.63.0"
  }
}
